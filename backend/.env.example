# Flymony Backend Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (Production'da en az 32 karakterlik rastgele karmaşık bir anahtar girin)
JWT_SECRET=flymony_jwt_super_secret_key_change_in_production_2026

# Cookie Secret
COOKIE_SECRET=flymony_cookie_secret_key_2026

# Varsayılan Admin Kullanıcısı (Veritabanında admin yoksa ilk açılışta oluşturulur)
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=FlymonyAdmin2026!
ADMIN_EMAIL=admin@flymony.local

# İzin Verilen Alan Adları (CORS - Virgülle ayrılmış)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173
